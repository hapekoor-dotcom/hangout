# Server only. Never use a VITE_ prefix for these values.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional overrides; defaults work with the three required variables.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: protects POST /api/ingest for bulk indexing. Search bootstraps automatically.
CRON_SECRET=
# VITE_AI_SEARCH=0 explicitly enables legacy local rules instead of server search.
